# Force HTTPS
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
  # HSTS. includeSubDomains/preload deliberately left off until HTTPS is
  # confirmed working on every wildpear.school subdomain (crm, enrolled) -
  # once confirmed, this is safe to widen but is hard to undo (browsers
  # cache it), so opt in on purpose rather than by default.
  Header always set Strict-Transport-Security "max-age=15552000"

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Built from an audit of actual site usage (2026-08-12, updated 2026-08-13
  # for the enrolled-students Google Calendar embed, 2026-08-13 to open
  # img-src to any https host, 2026-08-14 for the reCAPTCHA v2 checkbox on
  # the contact form, and 2026-08-15 for the live n8n webhook): the
  # Resources page/preview renders each external link's og:image (fetched
  # at build time, src/lib/utils/ogImage.ts) directly from its origin site,
  # which could be anything - hence img-src allows https: broadly rather
  # than an allowlist. frame-src covers the Google Maps tour-request embed,
  # the YouTube (nocookie) embed used by Feature10, the Google Calendar
  # embed on the enrolled portal, and the reCAPTCHA widget iframe.
  # script-src/connect-src additions are for reCAPTCHA's api.js and its
  # background verification calls (both www.google.com and
  # recaptcha.google.com since Google load-balances the widget across
  # both). connect-src also allows n8n.wildpear.school - the contact form's
  # fetch() posts there (see docs/enrollment-form-plan.md).
  Header always set Content-Security-Policy "\
    default-src 'self'; \
    script-src 'self' https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/ https://recaptcha.google.com/recaptcha/; \
    style-src 'self' 'unsafe-inline'; \
    img-src 'self' data: https:; \
    font-src 'self' data:; \
    frame-src https://www.youtube-nocookie.com https://www.google.com https://maps.google.com https://calendar.google.com https://recaptcha.google.com; \
    connect-src 'self' https://www.google.com https://recaptcha.google.com https://n8n.wildpear.school; \
    object-src 'none'; \
    base-uri 'self'; \
    form-action 'self'; \
    frame-ancestors 'self'"
</IfModule>
