{
  "name": "Contact Form - reCAPTCHA Verify",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "contact-form",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Contact Form Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://www.google.com/recaptcha/api/siteverify",
        "sendBody": true,
        "specifyBody": "form",
        "bodyParameters": {
          "parameters": [
            {
              "name": "secret",
              "value": "={{ $env.RECAPTCHA_SECRET_KEY }}"
            },
            {
              "name": "response",
              "value": "={{ $json.body['g-recaptcha-response'] }}"
            }
          ]
        },
        "options": {}
      },
      "id": "verify-recaptcha",
      "name": "Verify reCAPTCHA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "recaptcha-passed",
      "name": "reCAPTCHA Passed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "content": "## Downstream action not built yet\n\nOn the true branch, this should actually deliver the message\n(email via SMTP, and/or an EspoCRM record - see\ndocs/espocrm-data-model.md and Quire #45 for the SMTP piece).\n\nFor now this branch just responds success so the flow can be\ntested end-to-end with a real reCAPTCHA check before the delivery\nstep is built.",
        "height": 220,
        "width": 320
      },
      "id": "todo-note",
      "name": "TODO: wire up delivery",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [660, -180]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": true } }}",
        "options": {}
      },
      "id": "respond-success",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [660, -80]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": false, \"error\": \"reCAPTCHA verification failed\" } }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "respond-failure",
      "name": "Respond Failure",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [660, 120]
    }
  ],
  "connections": {
    "Contact Form Webhook": {
      "main": [[{ "node": "Verify reCAPTCHA", "type": "main", "index": 0 }]]
    },
    "Verify reCAPTCHA": {
      "main": [[{ "node": "reCAPTCHA Passed?", "type": "main", "index": 0 }]]
    },
    "reCAPTCHA Passed?": {
      "main": [
        [{ "node": "Respond Success", "type": "main", "index": 0 }],
        [{ "node": "Respond Failure", "type": "main", "index": 0 }]
      ]
    }
  }
}
