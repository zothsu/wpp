---
import Background4 from "../components/starwind-pro/background-04/Background4.astro";
import Cta10 from "../components/starwind-pro/cta-10/Cta10.astro";
import FormTourRequest, {
  type ServiceOption,
} from "../components/form-tourRequest.astro";
import Feature8 from "../components/starwind-pro/feature-08/Feature8.astro";
import Feature10, {
  type FeatureSection,
} from "../components/starwind-pro/feature-10/Feature10.astro";
import { faqs } from "../data/faqs";
import AboutLayout from "../layouts/AboutLayout.astro";

const faqAccordionItems = faqs.map((item, idx) => ({
  value: `faq-${idx + 1}`,
  question: item.title,
  answer: item.content,
}));

// TODO: still need real photos for Ability to Clearly Communicate, Ability to
// Care for Oneself, and Anti-Bias Mindset - no good match among the photos we
// have yet, so those three stay on the placeholder for now.
const placeholderImage = {
  src: "/images/temp1.jpg",
  alt: "Placeholder image - swap for real photo",
  width: 1024,
  height: 693,
};

const approachThemes: FeatureSection[] = [
  {
    id: "emotional-safety",
    heading: "Emotional Safety and Confidence",
    description:
      "Young children are doing the critical work of figuring out who they are and what the world is about — and that comes with a lot of feelings! Teachers help guide children to safely feel and release emotions through movement, sensory experiences, and communication, building the emotional intelligence, self-regulation, perspective-taking, and empathy that comes from truly understanding our feelings.",
    image: {
      src: "/images/img_20230728_125229.webp",
      alt: "Two campers laughing outside with googly-eye stickers stuck to their faces",
      width: 686,
      height: 515,
    },
  },
  {
    id: "communication",
    heading: "Ability to Clearly Communicate",
    description:
      "Communication is one of our best tools to connect with others, and children are eager to develop their skill set. We expose children to a wide variety of words, signs, symbols, and body language so they can express their needs, emotions, and ideas — and understand others' — building skills useful for following directions, reporting events, and building relationships.",
    image: {
      src: "/images/communicate.webp",
      alt: "Two campers leaning in together over a table, discussing flowers and craft materials",
      width: 450,
      height: 600,
    },
  },
  {
    id: "self-care",
    heading: "Ability to Care for Oneself",
    description:
      "We help children develop agency, assertiveness, and active participation in their own lives. From the earliest years, children take an active role in their own feeding, diapering/toileting, resting, and dressing — building the self-awareness, self-advocacy, and bodily autonomy that comes from being trusted and encouraged to take care of themselves.",
    image: {
      src: "/images/care.webp",
      alt: "A toddler in a high chair feeding themselves",
      width: 318,
      height: 424,
    },
  },
  {
    id: "social-skills",
    heading: "Social Skills",
    description:
      "Group care gives children the chance to learn and grow alongside their age mates, moving from independent and onlooker play into side-by-side, associative, and eventually cooperative play. We explicitly teach children how to invite others into play, navigate conflict, ask for consent, set personal boundaries, and build a caring community together.",
    image: {
      src: "/images/img_9502.webp",
      alt: "A group of campers smiling together inside a playhouse structure",
      width: 778,
      height: 1037,
    },
  },
  {
    id: "executive-functioning",
    heading: "Executive Functioning",
    description:
      "The prefrontal cortex — responsible for connecting our feelings, instincts, and thinking — begins developing around age 4 and continues into our early twenties. We give children ample opportunity and space to practice focus and self-control, making connections, critical thinking, taking on challenges, and self-directed engaged learning, building an essential foundation for their continued development.",
    image: {
      src: "/images/img_1569.webp",
      alt: "Campers deeply focused together on a collaborative sidewalk chalk drawing",
      width: 3024,
      height: 4032,
    },
  },
  {
    id: "anti-bias",
    heading: "Anti-Bias Mindset",
    description:
      "There is a lot of work to do to dismantle the systems of injustice that exist in society, and that work can begin with even the youngest children by developing an anti-bias mindset — building self-awareness and positive social identities alongside comfort and joy with human diversity. We celebrate the differences and similarities within our community, read and discuss books that reflect the world's diversity, and interrupt play and attitudes that reinforce stereotypes or hurtful social constructs.",
    image: {
      src: "/images/anti-bias-brain.svg",
      alt: "Illustration of children of different backgrounds holding hands in a circle around a globe (temporary, unlicensed placeholder)",
      width: 1600,
      height: 1690,
    },
  },
  {
    id: "outside-time",
    heading: "Enjoyment of Being Outside",
    description:
      "We consider ourselves a nature school, and while our indoor classroom reflects that focus, our outdoor classroom is even richer. Every day, rain or shine, we dress for the weather and head outside — exploring wood, rock, water, and soil, discovering ecosystems and life cycles, and tending our greenhouse, garden beds, laying hens, and fruiting trees.",
    image: {
      src: "/images/summer.webp",
      alt: "Campers laughing during outdoor water play",
      width: 834,
      height: 1112,
    },
  },
  {
    id: "animals-and-food",
    heading: "Caring for Animals and Growing Food",
    description:
      "Wild Pear is home to laying hens, a greenhouse, and garden beds full of vegetables and fruit we grow ourselves. Children take part in the daily rhythms of caring for them — feeding the hens, harvesting what's ready, and getting their hands in the dirt — building an understanding of where food comes from and the responsibility that comes with caring for another living creature.",
    image: {
      src: "/images/img_2982.webp",
      alt: "A camper feeding fresh greens to Wild Pear's laying hens through their coop fence",
      width: 304,
      height: 405,
    },
  },
];

const programInterestOptions: ServiceOption[] = [
  { value: "infant-toddler", label: "Infant/Toddler" },
  { value: "preschool", label: "Preschool" },
  { value: "summer-camp", label: "School Age Summer Camp" },
  { value: "no-program", label: "No Program / Not Sure Yet" },
];

const tourAddress = "9411 SE Wichita Ave, Portland, OR";
const tourMapEmbedUrl = `https://maps.google.com/maps?q=${encodeURIComponent(tourAddress)}&output=embed`;
---

<AboutLayout
  title="Our Approach to Learning | Wild Pear Preschool & Summer Camp"
>
  <div class="relative">
    <Background4 color1="green-600" color2="orange-500" color3="stone-600" />

    <section class="relative z-10 mx-auto max-w-3xl px-4 py-16">
      <h1>Our Approach to Learning</h1>
      <div class="text-muted-foreground mt-4 space-y-4 text-pretty">
        <p>
          At Wild Pear, our goal is to meet children where they are at
          developmentally and encourage them to move forward in their own unique
          way.
        </p>
        <p>
          Providing time away from a "plugged in" life, we offer space and time
          for holistic, multifaceted education.
        </p>
        <p>
          Our curriculum is rooted in long stretches of uninterrupted play and
          guided by child interest. We center around eight major themes which
          often overlap and are woven together throughout our days and across
          our school year. Respecting children and their play, we acknowledge it
          as real work and are honored to do our work alongside them. Continue
          below to learn more about our central themes.
        </p>
      </div>
    </section>

    <Feature10 sections={approachThemes} class="relative z-10" />

    <Feature8
      id="faq"
      heading="Frequently Asked Questions"
      description="Answers to the questions we hear most from Wild Pear families."
      image={{
        src: "/images/faq-pana.svg",
        alt: "Illustration of two people surrounded by question marks",
        width: 500,
        height: 500,
      }}
      accordionItems={faqAccordionItems}
      class="relative z-10"
    />

    <Cta10
      id="enrollment-information"
      title="We're Currently Enrolling"
      description="Full time and part time slots are available. Learn more about our enrollment process."
      primaryButton={{
        text: "Enrollment Information",
        href: "/enrollment-information",
      }}
      class="relative z-10"
    />

    <section class="relative z-10 pb-16">
      <FormTourRequest
        badge="Schedule a Tour"
        heading="Schedule a Tour"
        description="Let us know a bit about your family and we'll reach out to set up a time to show you around."
        address={tourAddress}
        mapEmbedUrl={tourMapEmbedUrl}
        services={programInterestOptions}
        serviceLabel="Program(s) of Interest"
        serviceMultiple
        messagePlaceholder="Let us know the best time for you to come by for a tour."
      />
    </section>
  </div>
</AboutLayout>
