---
import AboutLayout from "../layouts/AboutLayout.astro";
import HeroMain from "../components/HeroMain.astro";
import WelcomeMessage from "../components/WelcomeMessage.astro";
import PhotoCarousel from "../components/PhotoCarousel.astro";
import Programs from "../components/Programs.astro";
import Enrollment from "../components/Enrollment.astro";
import ScheduleTour from "../components/ScheduleTour.astro";
---

<AboutLayout title="Wild Pear Preschool & Summer Camp" overlayNav>
  <HeroMain
    heading={`Wild Pear Preschool\n& Summer Camp for All Ages!`}
    primaryButtonText="Request a Tour"
    primaryButtonHref="/#request-tour"
    secondaryButtonText="Enrolled Student Portal"
    secondaryButtonHref="https://enrolled.wildpear.school"
    backgroundImage={{
      src: "/images/hero-bodhi.jpg",
      alt: "A Wild Pear School student exploring outdoors",
    }}
  />
  <WelcomeMessage />
  <PhotoCarousel />
  <Enrollment />
  <Programs />
  <ScheduleTour />
</AboutLayout>
