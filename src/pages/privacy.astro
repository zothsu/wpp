---
import Layout from "../layouts/Layout.astro";
import LegalPage2 from "../components/starwind-pro/legal-page-02/LegalPage2.astro";
import Contact2 from "../components/starwind-pro/contact-02/Contact2.astro";
---

<Layout title="Privacy Policy | Wild Pear School">
	<div class="mx-auto max-w-6xl px-4 pt-8">
		<a href="/" class="text-muted-foreground hover:text-foreground text-sm transition-colors"
			>&larr; Back to Wild Pear School</a
		>

		<div class="bg-muted border-border text-muted-foreground mt-6 rounded-lg border p-4 text-sm">
			This page is a draft starting point and has not yet been reviewed by an attorney. Please
			review it before treating it as final.
		</div>
	</div>

	<LegalPage2
		title="Privacy Policy"
		description="How we handle photos, records, and information at Wild Pear School."
		pubDate="Aug 4, 2026"
	>
		<h2>Photo &amp; Video Sharing</h2>
		<p>
			While your child is at school we regularly take photos and videos of them for a variety of
			reasons — to document the learning that's happening, to share with families, and
			occasionally to show the wider community what's happening at Wild Pear, including on our
			website.
		</p>
		<p>
			We share photos and videos of your child and their peers with you through our daily
			communication app, and occasionally through a shared Google Photos album.
		</p>
		<p>
			If you have concerns about your child's photo being shared outside the currently enrolled
			Wild Pear community, please let us know and we will honor that.
		</p>
		<p>
			Out of respect for other families, we ask that visiting parents and guardians not take their
			own photos or videos while on campus. Many children have specific photo-release plans in
			place, and we're all trusting one another to protect each child's privacy.
		</p>

		<h2>Information We Collect on This Website</h2>
		<p>
			This website does not currently collect personal information, use tracking cookies, or run
			analytics. It exists to share general information about our programs and to direct you to
			our About and Enrolled Student sites.
		</p>

		<h2>Enrollment &amp; Family Records</h2>
		<p>
			Personal information collected as part of enrollment — applications, emergency contacts,
			health and immunization records, and similar records — is handled according to our
			enrollment agreement and Oregon Department of Early Learning and Care requirements, and is
			kept confidential except as required by law, including mandated reporting.
		</p>
	</LegalPage2>

	<Contact2
		badge="Questions"
		heading="Have a Privacy Question?"
		description="If you have questions or concerns about privacy at Wild Pear School, send us a message and we'll get back to you."
	/>
</Layout>
