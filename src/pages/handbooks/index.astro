---
import EnrolledLayout from "../../layouts/EnrolledLayout.astro";

const handbooks = [
	{
		title: "Family Handbook",
		description: "The full 2025-2026 Family Handbook, covering every program.",
		href: "/handbooks/family",
	},
	{
		title: "Preschool Handbook",
		description: "For families in our Preschool program.",
		href: "/handbooks/preschool",
	},
	{
		title: "Infant & Toddler (Sprouts) Handbook",
		description: "For families in our Infant & Toddler program.",
		href: "/handbooks/infant-toddler",
	},
	{
		title: "School Age Summer Camp Handbook",
		description: "For families joining us for summer camp.",
		href: "/handbooks/summer-camp",
	},
];
---

<EnrolledLayout title="Family Handbooks | Wild Pear Preschool & Summer Camp">
	<section class="mx-auto max-w-3xl px-4 py-16">
		<h1>Family Handbooks</h1>
		<p class="text-muted-foreground mt-4 text-pretty">
			Each program has its own handbook. Choose the one that matches your child's program below.
		</p>

		<ul class="mt-8 space-y-4">
			{
				handbooks.map((handbook) => (
					<li>
						<a
							href={handbook.href}
							class="border-border hover:border-primary-accent flex items-center gap-4 rounded-lg border bg-black/40 p-4 transition-colors"
						>
							<img
								src="/images/handbook.svg"
								alt=""
								aria-hidden="true"
								width="1280"
								height="660"
								class="h-10 w-auto shrink-0 invert"
							/>
							<div>
								<h2 class="text-lg font-semibold">{handbook.title}</h2>
								<p class="text-muted-foreground mt-1 text-sm">{handbook.description}</p>
							</div>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</EnrolledLayout>
