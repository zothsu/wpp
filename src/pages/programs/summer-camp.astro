---
import AboutLayout from "../../layouts/AboutLayout.astro";
import Cta10 from "../../components/starwind-pro/cta-10/Cta10.astro";
import ScheduleTour from "../../components/ScheduleTour.astro";
import ServicePage6 from "../../components/starwind-pro/service-page-06/ServicePage6.astro";
---

<AboutLayout title="School Age Summer Camp | Wild Pear Preschool & Summer Camp">
	<ServicePage6
		title="School Age Summer Camp"
		description="Are you looking for fun, safe, outdoor camp-style care for your child? Wild Pear is thrilled to offer weekly science, art, and nature-based camps throughout the summer. Kids have plenty of time to play and enjoy their days while also diving into hands-on exploration of a variety of exciting topics."
		badge="Ages 5-10"
		image="/images/alexandr-podvalny-bh476ojZw2g-unsplash.jpg"
		imageWidth={6000}
		imageHeight={4000}
		highlights={[
			{ label: "Cost", value: "$350/week" },
			{ label: "Schedule", value: "Mon-Fri, 8:30am-3:00pm" },
		]}
		ctaText="View the Handbook"
		ctaHref="/handbook/summer-camp"
	>
		<h2>Cost & Schedule</h2>
		<ul>
			<li>
				Each week costs $350 and runs Monday-Friday, 8:30-3:00, with the exception of closures
				on July 3rd and July 10th.
			</li>
			<li>
				Free, flexible drop-off starts at 7:30 each morning, and a free morning snack is
				provided every day.
			</li>
			<li>
				Optional aftercare is available from 3:00-5:00 every day camp is open, and includes an
				afternoon snack. Aftercare costs $175 per week, or $50 for a single afternoon.
			</li>
			<li>
				Families wishing to use DHS/ERDC will need to pay for camp at the time of reservation;
				we will reimburse you after DHS pays us.
			</li>
		</ul>

		<h2>Cancellation Policy</h2>
		<p>
			We understand that sometimes plans change. You can cancel your camp enrollment for a full
			refund before May 1st. After that, you can cancel 6 weeks before camp for a 50% refund. We
			are unable to offer refunds for cancellations made less than 6 weeks before the start
			date, due to staffing commitments.
		</p>

		<h2>What to Expect</h2>
		<p>
			Camps will be offered for nine weeks this summer. Each week, children will be outside all
			day and will have abundant opportunities to choose their own adventures: arts and crafts,
			building and tinkering, games and puzzles, gardening and food projects, sports and water
			play, and just enjoying being a kid outside in the summer. Each week also has its own
			theme, giving us a chance for some exciting, focused exploration of a particular topic.
		</p>

		<h2>Registration</h2>
		<p>
			Summer 2026 School Age Camp registration opens March 1st. Each camp's sign-up page, along
			with the School Age Summer Camp Handbook and enrollment form, will be linked here once
			registration is live.
		</p>
		<p>
			Please note: the "Younger Sibling Camp" and "Junior Camp Counselor" programs are only
			available to currently enrolled Wild Pear children (siblings) or Wild Pear alumni
			(counselors). Both the School Age K/1 and 2-5 sign-ups are open to everyone: current
			families, alumni, and new friends!
		</p>
	</ServicePage6>

	<ScheduleTour />

	<Cta10
		title="Read the Summer Camp Handbook"
		description="Our School Age Summer Camp Handbook covers daily schedules, health and safety policies, and what to expect while your child is in our care."
		primaryButton={{ text: "View the Summer Camp Handbook", href: "/handbook/summer-camp" }}
	/>
</AboutLayout>
