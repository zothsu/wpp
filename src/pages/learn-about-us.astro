		secondaryLinkHref="/our-approach"
		image={{
			src: "/images/taylor-heery-g7dUm6lRvtQ-unsplash.jpg",
			alt: "A Wild Pear student creating art with torn paper",
			width: 1200,
			height: 1800,
		}}
	/>
	<Programs />
</AboutLayout>
