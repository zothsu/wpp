---
import { Prose } from "../components/starwind/prose";
import WelcomeEnrolled from "../components/WelcomeEnrolled.astro";
import PreviewResources from "../components/preview-resources.astro";
import PreviewHandbooks from "../components/preview-handbooks.astro";
import PreviewForms from "../components/preview-forms.astro";
import PreviewTuition from "../components/preview-tuition.astro";
import EnrolledLayout from "../layouts/EnrolledLayout.astro";
---

<EnrolledLayout title="Enrolled Students | Wild Pear Preschool & Summer Camp">
	<WelcomeEnrolled />
	<section class="mx-auto max-w-3xl px-4 py-16">
		<h1>Wild Pear Calendar</h1>
		<Prose class="mt-4">
			<h2>WP Calendar 2025-2026</h2>

			<section>
				<h3>August 2025</h3>
				<dl>
					<dt><time datetime="2025-08-28">Thursday, 8/28</time></dt>
					<dd>Open House, 3-6pm</dd>
				</dl>
			</section>

			<section>
				<h3>September 2025</h3>
				<dl>
					<dt><time datetime="2025-09-01">Monday, 9/1</time></dt>
					<dd>Closed: Labor Day</dd>
					<dt>Tuesday & Wednesday, 9/2-9/3</dt>
					<dd>Slow Start Days</dd>
					<dt><time datetime="2025-09-04">Thursday, 9/4</time></dt>
					<dd>First day of the 2025-2026 school year</dd>
					<dt><time datetime="2025-09-09">Tuesday, 9/9</time></dt>
					<dd>Closed at 3:00: Staff Meeting</dd>
					<dt><time datetime="2025-09-26">Friday, 9/26</time></dt>
					<dd>
						Back to school night, 4:30-5:45p walk through and family dinner, 5:45-6:45p presentation
					</dd>
				</dl>
			</section>

			<section>
				<h3>October 2025</h3>
				<dl>
					<dt><time datetime="2025-10-13">Monday, 10/13</time></dt>
					<dd>Closed: Indigenous Peoples' Day</dd>
					<dt><time datetime="2025-10-14">Tuesday, 10/14</time></dt>
					<dd>Closed at 3:00: Staff Meeting</dd>
					<dt><time datetime="2025-10-24">Friday, 10/24</time></dt>
					<dd>Closed at 2:30: Pumpkin Patch Family Trip, 3-5p</dd>
				</dl>
			</section>

			<section>
				<h3>November 2025</h3>
				<dl>
					<dt><time datetime="2025-11-11">Tuesday, 11/11</time></dt>
					<dd>Closed at 3:00: Staff Meeting</dd>
					<dt><time datetime="2025-11-26">Wednesday, 11/26</time></dt>
					<dd>Closed: Family Conferences</dd>
					<dt>Thursday & Friday, 11/27-11/28</dt>
					<dd>Closed: Fall Break</dd>
				</dl>
			</section>

			<section>
				<h3>December 2025</h3>
				<dl>
					<dt><time datetime="2025-12-05">Friday, 12/5</time></dt>
					<dd>Parent's Night Out, 5:00-8:00p</dd>
					<dt><time datetime="2025-12-09">Tuesday, 12/9</time></dt>
					<dd>Closed at 3:00: Staff Meeting</dd>
					<dt>12/22-12/31</dt>
					<dd>Closed for Winter Break</dd>
				</dl>
			</section>

			<section>
				<h3>January 2026</h3>
				<dl>
					<dt>1/1-1/2</dt>
					<dd>Closed for Winter Break</dd>
					<dt><time datetime="2026-01-13">Tuesday, 1/13</time></dt>
					<dd>Closed at 3:00: Staff Meeting</dd>
					<dt><time datetime="2026-01-19">Monday, 1/19</time></dt>
					<dd>Closed: Martin Luther King Jr. Day</dd>
				</dl>
			</section>

			<section>
				<h3>February 2026</h3>
				<dl>
					<dt><time datetime="2026-02-10">Tuesday, 2/10</time></dt>
					<dd>Closed at 3:00: Staff Meeting</dd>
					<dt><time datetime="2026-02-16">Monday, 2/16</time></dt>
					<dd>Closed: President's Day</dd>
					<dt>Monday & Tuesday, 2/23-2/24</dt>
					<dd>Closed: Inservice</dd>
				</dl>
			</section>

			<section>
				<h3>March 2026</h3>
				<dl>
					<dt><time datetime="2026-03-10">Tuesday, 3/10</time></dt>
					<dd>Closed at 3:00: Staff Meeting</dd>
					<dt>3/23-3/27</dt>
					<dd>Closed for Spring Break</dd>
				</dl>
			</section>

			<section>
				<h3>April 2026</h3>
				<dl>
					<dt><time datetime="2026-04-14">Tuesday, 4/14</time></dt>
					<dd>Closed at 3:00: Staff Meeting</dd>
					<dt><time datetime="2026-04-15">Wednesday, 4/15</time></dt>
					<dd>Closed: Family Conferences</dd>
				</dl>
			</section>

			<section>
				<h3>May 2026</h3>
				<dl>
					<dt><time datetime="2026-05-16">Saturday, 5/16</time></dt>
					<dd>Spring Fling, time TBD</dd>
					<dt><time datetime="2026-05-12">Tuesday, 5/12</time></dt>
					<dd>Closed at 3:00: Staff Meeting</dd>
					<dt><time datetime="2026-05-25">Monday, 5/25</time></dt>
					<dd>Closed: Memorial Day</dd>
				</dl>
			</section>

			<section>
				<h3>June 2026</h3>
				<dl>
					<dt><time datetime="2026-06-09">Tuesday, 6/9</time></dt>
					<dd>Closed at 3:00: Staff Meeting</dd>
					<dt><time datetime="2026-06-12">Friday, 6/12</time></dt>
					<dd>Last day of the school year</dd>
					<dt><time datetime="2026-06-12">Friday, 6/12</time></dt>
					<dd>Campfire Night, 5-7pm</dd>
					<dt><time datetime="2026-06-22">Monday, 6/22</time></dt>
					<dd>School Age Summer Camp begins</dd>
				</dl>
			</section>

			<section>
				<h3>July 2025</h3>
				<dl>
					<dt>TBD</dt>
					<dd>Wild Pear Camping Trip</dd>
				</dl>
			</section>
		</Prose>
	</section>
	<PreviewResources />
	<PreviewTuition />
	<PreviewHandbooks />
	<PreviewForms />
</EnrolledLayout>
