---
import Layout from "../layouts/Layout.astro";
import LegalPage2 from "../components/starwind-pro/legal-page-02/LegalPage2.astro";
import Contact2 from "../components/starwind-pro/contact-02/Contact2.astro";
---

<Layout title="Terms of Service | Wild Pear School">
	<div class="mx-auto max-w-6xl px-4 pt-8">
		<a href="/" class="text-muted-foreground hover:text-foreground text-sm transition-colors"
			>&larr; Back to Wild Pear School</a
		>

		<div class="bg-muted border-border text-muted-foreground mt-6 rounded-lg border p-4 text-sm">
			This page is a draft starting point and has not yet been reviewed by an attorney. Please
			review it before treating it as final.
		</div>
	</div>

	<LegalPage2
		title="Terms of Service"
		description="The terms that govern your use of this website."
		pubDate="Aug 4, 2026"
	>
		<h2>About This Site</h2>
		<p>
			This website provides general information about Wild Pear School and directs visitors to
			our About and Enrolled Student sites. It is not itself an enrollment contract — enrollment,
			tuition, and program terms are governed by our separate enrollment agreement and Family
			Handbook.
		</p>

		<h2>Licensing &amp; Regulatory Compliance</h2>
		<p>
			Both our programs are licensed as Certified Family Child Care, and these are the <a
				href="https://www.oregon.gov/delc/providers/pages/child-care-rules.aspx"
				target="_blank"
				rel="noopener noreferrer">Oregon State rules and regulations</a
			> we abide by.
		</p>
		<p>
			If you have a question, complaint, or a problem, we would love to have a discussion with
			you. If you do not feel comfortable with that, or feel that it is serious, you may make an
			official complaint to the <a
				href="https://www.oregon.gov/delc/pages/report-concern.aspx"
				target="_blank"
				rel="noopener noreferrer">Oregon Department of Early Learning and Care here</a
			>.
		</p>

		<h2>USDA Food Program</h2>
		<p>
			We are reimbursed for some of our food costs through the USDA food program. To participate,
			we are required to follow their guidelines about food quality, variety, and portion size. We
			are also required to tell you that we will not discriminate when it comes to enrolling
			children into the food program. You can read more about the <a
				href="https://www.fna.usda.gov/civil-rights/nds"
				target="_blank"
				rel="noopener noreferrer">anti-discrimination policy</a
			> and the <a
				href="https://www.fna.usda.gov/cacfp"
				target="_blank"
				rel="noopener noreferrer">specific food program we use</a
			>.
		</p>

		<h2>Content &amp; Intellectual Property</h2>
		<p>
			Photos, logos, and other content on this site belong to Wild Pear School and may not be
			reused without permission.
		</p>

		<h2>Accuracy of Information</h2>
		<p>
			We do our best to keep information on this site current, but details like our calendar,
			tuition, and policies may change. If anything here conflicts with the Family Handbook or
			direct communication from us, the Handbook and direct communication govern.
		</p>

		<h2>Third-Party Links</h2>
		<p>
			This site links to our About and Enrolled Student sites, as well as other outside resources
			from time to time. We aren't responsible for the content or practices of those third-party
			sites.
		</p>

		<h2>Limitation of Liability</h2>
		<p>
			This site is provided as-is, without warranties of any kind, to the fullest extent permitted
			by law.
		</p>

		<h2>Governing Law</h2>
		<p>These terms are governed by the laws of the State of Oregon.</p>

		<h2>Changes to These Terms</h2>
		<p>
			We may update these terms from time to time. The "last updated" date at the top of this page
			reflects the most recent revision.
		</p>
	</LegalPage2>

	<Contact2
		badge="Questions"
		heading="Questions About These Terms?"
		description="Send us a message and we'll get back to you."
	/>
</Layout>
