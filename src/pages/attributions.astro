---
import Layout from "../layouts/Layout.astro";
import LegalPage2 from "../components/starwind-pro/legal-page-02/LegalPage2.astro";
---

<Layout title="Attributions | Wild Pear School">
	<div class="mx-auto max-w-6xl px-4 pt-8">
		<a href="/" class="text-muted-foreground hover:text-foreground text-sm transition-colors"
			>&larr; Back to Wild Pear School</a
		>
	</div>

	<LegalPage2
		title="Attributions"
		description="Credit for third-party assets used on this site."
		pubDate="Aug 9, 2026"
	>
		<h2>Illustrations</h2>
		<ul>
			<li>
				<a href="https://storyset.com/people" target="_blank" rel="noopener noreferrer"
					>People illustrations by Storyset</a
				>
			</li>
		</ul>
	</LegalPage2>
</Layout>
