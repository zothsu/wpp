---
import "../styles/starwind.css";
import "@fontsource/gochi-hand";
import "@fontsource/patrick-hand";

const candidates = [
  { name: "Gochi Hand", family: "Gochi Hand" },
  { name: "Patrick Hand (active heading font)", family: "Patrick Hand" },
];
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <title>Font Preview</title>
  </head>
  <body class="bg-background text-foreground min-h-screen p-10">
    <h1 class="font-heading mb-10 text-2xl">Handwriting font candidates</h1>
    <div class="grid gap-8">
      {
        candidates.map((c) => (
          <div class="border-border rounded-lg border p-6">
            <p class="text-muted-foreground mb-3 text-sm">{c.name}</p>
            <p style={{ fontFamily: c.family }} class="text-5xl">
              Wild Pear School
            </p>
            <p style={{ fontFamily: c.family }} class="mt-2 text-2xl">
              Cultivating your child's connections between self, one another, and the natural
              world
            </p>
          </div>
        ))
      }
    </div>
  </body>
</html>
