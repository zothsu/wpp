---
import "../styles/starwind.css";
import Navbar4, { type NavLink } from "../components/starwind-pro/navbar-04/Navbar4.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ShaderNightClouds from "../components/starwind-pro/shader-night-clouds/ShaderNightClouds.astro";
import IconPear from "../icons/pear.svg";

interface Props {
	title: string;
}

const { title } = Astro.props;

const links: NavLink[] = [
	{ label: "Forms", href: "/enrolled-students#forms" },
	{ label: "Handbooks", href: "/enrolled-students#handbooks" },
	{ label: "Tuition", href: "/enrolled-students#tuition" },
	{ label: "Resources", href: "/enrolled-students#resources" },
];
---

<html lang="en" class="dark">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<ShaderNightClouds />
		<Navbar4
			siteName="Wild Pear"
			links={links}
			ctaText="Contact"
			ctaHref="https://lookingat.wildpear.school/contact"
		>
			<a href="/" slot="logo" class="font-heading flex items-center gap-2 text-2xl font-semibold">
				<IconPear class="size-6" />
				Wild Pear
			</a>
		</Navbar4>
		<slot />
		<SiteFooter portal="enrolled" />
	</body>
</html>
