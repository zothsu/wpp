---
import IconSchool from "@tabler/icons/outline/school.svg";
import IconSeedling from "@tabler/icons/outline/seedling.svg";

import Feature12 from "./starwind-pro/feature-12/Feature12.astro";
---

<Feature12
  tagline="2025 - 2026"
  heading="Tuition Information"
  tabs={[
    { id: "sprouts", label: "Sprouts", icon: IconSeedling },
    { id: "preschool", label: "Preschool", icon: IconSchool },
  ]}
>
  <div slot="description" class="text-muted-foreground mx-auto mt-4 max-w-2xl space-y-3 text-left text-pretty">
    <p>
      <strong class="text-foreground font-semibold">Payment:</strong> Tuition is paid monthly
      for the 9.5-month school year (early September through mid-June), due on the 15th of the
      month before care is given, and stays the same regardless of illness, vacation, or
      closures.
    </p>
    <p>
      <strong class="text-foreground font-semibold">Included:</strong> Rates include meals,
      snacks, sunscreen, and diapering supplies.
    </p>
    <p>
      <strong class="text-foreground font-semibold">Assistance:</strong> We accept ERDC and
      other subsidies, along with partial scholarships for families who qualify.
    </p>
    <p>
      <strong class="text-foreground font-semibold">Hours:</strong> Monday through Friday,
      7:30am to 5:30pm.
    </p>
    <p>
      <strong class="text-foreground font-semibold">Changes:</strong> Changing or canceling a
      schedule requires 30 days' written notice.
    </p>
  </div>

  <div slot="tab-sprouts" class="mx-auto max-w-lg overflow-x-auto rounded-lg border">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b">
          <th class="text-foreground px-4 py-2 text-left font-semibold">Schedule</th>
          <th class="text-foreground px-4 py-2 text-left font-semibold">Monthly Rate</th>
        </tr>
      </thead>
      <tbody>
        <tr class="border-b">
          <td class="px-4 py-2">Five days</td>
          <td class="px-4 py-2">$2,225</td>
        </tr>
        <tr class="border-b">
          <td class="px-4 py-2">Four days</td>
          <td class="px-4 py-2">$2,075</td>
        </tr>
        <tr class="border-b">
          <td class="px-4 py-2">Three days</td>
          <td class="px-4 py-2">$1,825</td>
        </tr>
        <tr class="border-b last:border-b-0">
          <td class="px-4 py-2">Two days</td>
          <td class="px-4 py-2">$1,775</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div slot="tab-preschool" class="mx-auto max-w-md overflow-x-auto rounded-lg border">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b">
          <th class="text-foreground px-4 py-2 text-left font-semibold">Schedule</th>
          <th class="text-foreground px-4 py-2 text-left font-semibold">Monthly Rate</th>
        </tr>
      </thead>
      <tbody>
        <tr class="border-b">
          <td class="px-4 py-2">Five days</td>
          <td class="px-4 py-2">$1,725</td>
        </tr>
        <tr class="border-b">
          <td class="px-4 py-2">Four days</td>
          <td class="px-4 py-2">$1,575</td>
        </tr>
        <tr class="border-b">
          <td class="px-4 py-2">Three days</td>
          <td class="px-4 py-2">$1,425</td>
        </tr>
        <tr class="border-b last:border-b-0">
          <td class="px-4 py-2">Two days</td>
          <td class="px-4 py-2">$1,275</td>
        </tr>
      </tbody>
    </table>
  </div>

</Feature12>

<div class="mx-auto mt-12 max-w-xl text-center">
  <h3 class="font-heading text-3xl font-semibold md:text-4xl lg:text-5xl">Summer Camp Rates</h3>
  <p class="text-muted-foreground mt-2 text-sm">
    Camp runs 7:30am-3:00pm; aftercare available 3:00pm-5:00pm. All rates are per week.
  </p>
  <div class="mt-4 overflow-x-auto rounded-lg border text-left">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b">
          <th class="text-foreground px-4 py-2 text-left font-semibold">Group</th>
          <th class="text-foreground px-4 py-2 text-left font-semibold">Rate</th>
        </tr>
      </thead>
      <tbody>
        <tr class="border-b">
          <td class="px-4 py-2">
            Humming Birds
            <span class="text-muted-foreground block text-xs">
              Younger Sibling Camp, WP Sprouts
            </span>
          </td>
          <td class="px-4 py-2">$430/week</td>
        </tr>
        <tr class="border-b">
          <td class="px-4 py-2">
            Chickadees
            <span class="text-muted-foreground block text-xs">
              School Age Camp K/1, WP Preschool
            </span>
          </td>
          <td class="px-4 py-2">$350/week</td>
        </tr>
        <tr class="border-b">
          <td class="px-4 py-2">
            Robins
            <span class="text-muted-foreground block text-xs">
              School Age Camp 2nd-5th, WP Back Lot
            </span>
          </td>
          <td class="px-4 py-2">$350/week</td>
        </tr>
        <tr class="border-b">
          <td class="px-4 py-2">
            Junior Counselors
            <span class="text-muted-foreground block text-xs">
              Middle School Camp (alumni only), WP Back Lot
            </span>
          </td>
          <td class="px-4 py-2">$300/week</td>
        </tr>
        <tr class="border-b">
          <td class="px-4 py-2">Aftercare (3-5pm)</td>
          <td class="px-4 py-2">$175/week</td>
        </tr>
        <tr class="border-b last:border-b-0">
          <td class="px-4 py-2">Aftercare, single day</td>
          <td class="px-4 py-2">$50/day</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
