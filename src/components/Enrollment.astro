---
import IconBook from "@tabler/icons/outline/book.svg";
import IconClipboardCheck from "@tabler/icons/outline/clipboard-check.svg";
import IconMapPin from "@tabler/icons/outline/map-pin.svg";

import Services8, { type ProcessStep } from "./starwind-pro/services-08/Services8.astro";

const steps: ProcessStep[] = [
	{
		icon: IconBook,
		title: 'Read About "Our Approach"',
		href: "/our-approach",
		description:
			"It's important to feel comfortable with where your child is receiving care — read about our approach to food, outside time, and emotionally cognizant care.",
	},
	{
		icon: IconMapPin,
		title: "Request a Tour",
		href: "/#request-tour",
		description:
			"Come visit us and see if we resonate with what you have in mind for your child's care. Meet our teachers, see the classrooms and yard, and let us meet your child too.",
	},
	{
		icon: IconClipboardCheck,
		title: "Submit Your Application",
		// TODO: swap in the real application form URL once it's ready.
		href: "#",
		description:
			"After the tour, you'll be given a password to complete the paperwork online. A $500 deposit holds your slot, and children are enrolled based on age as of September 1st.",
	},
];
---

<Services8
	badge="How to Enroll"
	heading="3 Steps to Enroll at Wild Pear"
	description="From getting to know us to your child's first day of care, here's what the enrollment process looks like."
	steps={steps}
/>
