---
interface Props {
  heading?: string;
  quote?: string;
  body?: string;
  signoff?: string;
  signature?: string;
}

const {
  heading = "Welcome to Wild Pear!",
  quote = "Cultivating your child's connections between self, one another, and the natural world.",
  body = "At our school we get our hands dirty, we jump in puddles, we tell stories, we create things that have never existed, we cook and eat delicious food, we share and support feelings (even the big hard ones), we explore tirelessly, sing enthusiastically, and try new things everyday. Most of all, we want to be together, and we'd like to be with you too.",
  signoff = "Thank you!",
  signature = "Jeanie & Susan",
} = Astro.props;
---

<section class="@container bg-green-900">
  <div class="mx-auto max-w-5xl px-4 py-24 text-center">
    <h2>{heading}</h2>
    <blockquote class="border-primary-accent mx-auto mt-6 max-w-2xl border-l-4 pl-4 text-lg text-pretty italic">
      "{quote}"
    </blockquote>
    <div class="text-muted-foreground mt-8 space-y-4 text-pretty">
      <p>{body}</p>
      <p class="text-right">{signoff}</p>
      <p class="font-signature text-right text-3xl">{signature}</p>
    </div>
  </div>
</section>
