---
/**
 * Legal Page 2 - Sidebar TOC
 *
 * A legal page with a sticky table of contents sidebar, ideal for long documents.
 *
 * Usage:
 * 1. Use the starwind cli to add this component: `npx starwind@latest add @starwind-pro/legal-page-02`
 * 2. Import the `LegalPage2` component and pass your page data + slot content
 *
 * Props:
 * - title: string (required)
 * - description: string (required)
 * - pubDate: string (required)
 * - updatedDate?: string
 * - <slot /> for rendered content
 */
import LegalPage2 from "./LegalPage2.astro";
---

