---
import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";

import { Prose } from "@/components/starwind/prose";
import { Separator } from "@/components/starwind/separator";

interface Props extends HTMLAttributes<"article"> {
  /** Legal page title */
  title: string;
  /** Brief description or subtitle */
  description: string;
  /** Publication date string */
  pubDate: string;
  /** Last updated date string */
  updatedDate?: string;
  /** Use the body font instead of the heading font for all headings in this page */
  bodyHeadings?: boolean;
  /** Label shown before the pubDate, e.g. "Effective" or "Last Updated" */
  pubDateLabel?: string;
}

const sectionStyles = tv({
  base: "@container mx-auto w-full max-w-6xl px-4 py-24",
});

const {
  title,
  description,
  pubDate,
  updatedDate,
  bodyHeadings = false,
  pubDateLabel = "Effective",
  class: className,
  ...rest
} = Astro.props;
---

<article class={sectionStyles({ class: className })} data-body-headings={bodyHeadings} {...rest}>
  <!-- Header -->
  <header class="max-w-3xl">
    <h1>{title}</h1>

    <p class="text-muted-foreground mt-4 text-pretty">
      {description}
    </p>

    <div class="text-muted-foreground mt-4 flex items-center gap-1.5 text-sm">
      <span>{pubDateLabel}</span>
      <time datetime={pubDate}>{pubDate}</time>
      {
        updatedDate && (
          <>
            <span>&middot;</span>
            <span>
              Updated <time datetime={updatedDate}>{updatedDate}</time>
            </span>
          </>
        )
      }
    </div>
  </header>

  <Separator class="mt-8" />

  <!-- Content + TOC layout -->
  <div class="mt-10 grid gap-12 @3xl:grid-cols-[1fr_220px]">
    <!-- Main content -->
    <div class="min-w-0" id="legal-page-02-content">
      <Prose class="max-w-none">
        <slot />
      </Prose>
    </div>

    <!-- Sticky TOC sidebar -->
    <aside class="hidden @3xl:block">
      <nav class="sticky top-24" aria-label="Table of contents" id="legal-page-02-toc">
        <p class="text-sm font-semibold tracking-wide uppercase">On this page</p>
        <ul class="mt-3 space-y-2 text-sm" id="legal-page-02-toc-list">
          <!-- Populated by client-side script -->
        </ul>
      </nav>
    </aside>
  </div>
</article>

<style>
  article[data-body-headings="true"] h1,
  article[data-body-headings="true"] :global(.sw-prose :is(h1, h2, h3, h4, h5, h6)) {
    font-family: inherit;
  }
</style>

<script is:inline src="/scripts/legal-page-toc.js"></script>
