---
import IconCode from "@tabler/icons/outline/code.svg";
import IconPalette from "@tabler/icons/outline/palette.svg";
import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";

import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/starwind/tabs";

export interface FeatureTab {
  id: string;
  label: string;
  icon: any;
  title?: string;
  description?: string;
}

interface Props extends HTMLAttributes<"section"> {
  /** Section tagline */
  tagline?: string;
  /** Section heading */
  heading?: string;
  /** Optional description below the heading */
  description?: string;
  /** Heading tag for the section title. Use "h3" when nesting under another Feature12/h2 on the same page. */
  headingLevel?: "h2" | "h3";
  /** Array of feature tabs */
  tabs?: FeatureTab[];
}

const feature12Styles = tv({
  base: "@container mx-auto w-full max-w-6xl px-4 py-24",
});

const {
  tagline,
  heading = "Everything you need to build amazing products",
  description,
  headingLevel = "h2",
  tabs = [
    {
      id: "development",
      label: "Develop",
      icon: IconCode,
    },
    {
      id: "design",
      label: "Design",
      icon: IconPalette,
    },
  ],
  class: className,
  ...rest
} = Astro.props;

const HeadingTag = headingLevel;
---

<section class={feature12Styles({ class: className })} {...rest}>
  <div class="mb-16 text-center">
    {tagline && (
      <div class="text-primary-accent mb-4 text-lg font-medium">
        {tagline}
      </div>
    )}
    <HeadingTag
      class:list={[
        "mx-auto max-w-3xl",
        headingLevel === "h3" && "font-heading text-3xl font-semibold tracking-tight md:text-4xl lg:text-5xl",
      ]}
    >
      {heading}
    </HeadingTag>
    {description && (
      <p class="text-muted-foreground mx-auto mt-4 max-w-2xl text-pretty">{description}</p>
    )}
    <slot name="description" />
  </div>

  <Tabs defaultValue={tabs[0].id} class="w-full">
    <TabsList
      class="bg-muted/50 mx-auto mb-12 grid max-w-md @xs:w-full"
      style={`grid-template-columns: repeat(${tabs.length}, minmax(0, 1fr))`}
    >
      {
        tabs.map((tab) => (
          <TabsTrigger value={tab.id} class="w-full gap-2">
            <tab.icon class="size-4" aria-hidden="true" />
            <span>{tab.label}</span>
          </TabsTrigger>
        ))
      }
    </TabsList>

    {
      tabs.map((tab) => (
        <TabsContent value={tab.id}>
          {tab.title && (
            <h3 class="font-heading mb-4 text-2xl font-semibold @xl:text-3xl">{tab.title}</h3>
          )}
          {tab.description && (
            <p class="text-muted-foreground mb-8 text-pretty">{tab.description}</p>
          )}
          <slot name={`tab-${tab.id}`} />
        </TabsContent>
      ))
    }
  </Tabs>
</section>
