---
import IconSparkles from "@tabler/icons/outline/sparkles.svg";
import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";

import { Button } from "@/components/starwind/button";

interface Props extends HTMLAttributes<"section"> {
  /** Badge text */
  badgeText?: string;
  /** Badge href */
  badgeHref?: string;
  /** Badge icon component */
  badgeIcon?: any;
  /** Main heading text */
  heading?: string;
  /** Description text */
  description?: string;
  /** Primary button text */
  primaryButtonText?: string;
  /** Primary button href */
  primaryButtonHref?: string;
  /** Secondary button text */
  secondaryButtonText?: string;
  /** Secondary button href */
  secondaryButtonHref?: string;
  /** Background image configuration */
  backgroundImage?: {
    src: string;
    alt: string;
  };
}

const hero11Styles = tv({
  base: "dark bg-background text-foreground @container relative h-screen w-full overflow-hidden",
});

const {
  badgeText = "New features released",
  badgeHref = "#",
  badgeIcon: BadgeIcon = IconSparkles,
  heading = "Accelerate Your Development Workflow",
  description,
  primaryButtonText = "Start Free Trial",
  primaryButtonHref = "#",
  secondaryButtonText,
  secondaryButtonHref = "#",
  backgroundImage = {
    src: "https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1920&auto=format&fit=crop&q=80",
    alt: "Mountain landscape",
  },
  class: className,
  ...rest
} = Astro.props;
---

<section class={hero11Styles({ class: className })} {...rest}>
  <!-- Background Image -->
  <div class="relative min-h-full">
    <!-- you may need to adjust the "min-h-[500px]" class here depending on your content overlay size -->
    <img
      src={backgroundImage.src}
      alt={backgroundImage.alt}
      class="h-full min-h-[500px] w-full object-cover"
    />
    <div class="absolute inset-0 h-full w-full bg-black/50"></div>
  </div>

  <!-- Content Overlay -->
  <div class="absolute inset-0 flex items-center">
    <div class="mx-auto w-full max-w-5xl px-4 text-center @xl:px-8">
      <!-- Badge -->
      <a
        href={badgeHref}
        class="text-foreground border-foreground/20 hover:bg-muted dark:hover:bg-input/50 bg-input/30 focus-visible:ring-outline/50 focus-visible:border-outline mx-auto mb-6 flex w-fit items-center gap-2 rounded-full border px-3 py-0.5 text-sm backdrop-blur-sm transition-all outline-none focus-visible:ring-3"
      >
        <BadgeIcon class="size-4" />
        <span>{badgeText}</span>
      </a>

      <!-- Heading -->
      <h1
        class="from-foreground font-heading to-foreground/70 bg-linear-to-b bg-clip-text text-4xl font-extralight tracking-tighter text-pretty whitespace-pre-line text-transparent uppercase @xl:text-5xl @3xl:text-7xl"
      >
        {heading}
      </h1>

      <!-- Description -->
      {
        description && (
          <p class="text-foreground/90 mx-auto mt-6 max-w-2xl text-pretty @3xl:text-lg">
            {description}
          </p>
        )
      }

      <!-- Buttons -->
      <div class="mx-auto mt-8 flex flex-wrap justify-center gap-4">
        <Button href={primaryButtonHref}>{primaryButtonText}</Button>
        {
          secondaryButtonText && (
            <Button
              variant="outline"
              href={secondaryButtonHref}
              class="border-orange-400/60 bg-orange-400/10 hover:bg-orange-400/20 dark:border-orange-400/60 dark:bg-orange-400/10 dark:hover:bg-orange-400/20"
            >
              {secondaryButtonText}
            </Button>
          )
        }
      </div>
    </div>
  </div>
</section>
