---
import IconChevronDown from "@tabler/icons/outline/chevron-down.svg";
import IconMenu from "@tabler/icons/outline/menu-2.svg";
import IconX from "@tabler/icons/outline/x.svg";
import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";

import { Button } from "@/components/starwind/button";
import {
  Collapsible,
  CollapsibleContent,
  CollapsibleTrigger,
} from "@/components/starwind/collapsible";
import {
  Dropdown,
  DropdownContent,
  DropdownLinkItem,
  DropdownTrigger,
} from "@/components/starwind/dropdown";
import { Separator } from "@/components/starwind/separator";
import {
  Sheet,
  SheetClose,
  SheetContent,
  SheetFooter,
  SheetHeader,
  SheetTitle,
  SheetTrigger,
} from "@/components/starwind/sheet";

/** Navigation link structure */
export interface NavLink {
  /** Display text for the link */
  label: string;
  /** URL the link points to */
  href?: string;
  /** Nested sub-links */
  children?: NavLink[];
}

interface Props extends HTMLAttributes<"nav"> {
  /** Site name displayed when no logo slot is provided */
  siteName?: string;
  /** Array of navigation links */
  links?: NavLink[];
  /** Primary CTA button text */
  ctaText?: string;
  /** Primary CTA button href */
  ctaHref?: string;
  /** Secondary button text (optional) */
  secondaryText?: string;
  /** Secondary button href */
  secondaryHref?: string;
  /** Render as a fixed transparent overlay, hidden until the user scrolls
   * past the first viewport height, then faded in - for pages with a
   * full-screen hero the nav should sit on top of instead of pushing down. */
  overlay?: boolean;
}

const navStyles = tv({
  base: "data-scrolled:bg-background/40 @container inset-x-0 top-0 z-50 border-transparent transition-all duration-300 border-b group data-scrolled:border-border data-scrolled:backdrop-blur",
  variants: {
    overlay: {
      true: "fixed -translate-y-2 pointer-events-none opacity-0 data-revealed:pointer-events-auto data-revealed:translate-y-0 data-revealed:opacity-100",
      false: "sticky",
    },
  },
  defaultVariants: {
    overlay: false,
  },
});

const {
  siteName = "Starwind Pro",
  links = [],
  ctaText = "Get Started",
  ctaHref = "#",
  secondaryText,
  secondaryHref = "#",
  overlay = false,
  class: className,
  ...rest
} = Astro.props;
---

<nav
  class={navStyles({ overlay, class: className })}
  data-navbar-4
  data-overlay={overlay || undefined}
  {...rest}
>
  <div
    class="mx-auto flex h-18 max-w-7xl items-center justify-between px-4 transition-[height] duration-300 group-data-scrolled:h-14"
  >
    <!-- Mobile Menu Button (Left Side) -->
    <div class="mr-2 @2xl:hidden">
      <Sheet>
        <SheetTrigger asChild>
          <Button variant="ghost" size="icon" class="[&_svg]:size-6" aria-label="Open menu">
            <IconMenu />
          </Button>
        </SheetTrigger>
        <SheetContent
          id="navbar-4-sheet-content"
          side="left"
          class="max-w-[280px] sm:max-w-[300px]"
        >
          <SheetHeader>
            <SheetTitle class="text-left">
              <slot name="logo">
                <span class="font-heading text-2xl font-semibold">{siteName}</span>
              </slot>
            </SheetTitle>
            <Separator class="mt-2" />
          </SheetHeader>

          <div class="-mt-5 flex flex-col gap-4 px-4" data-nav-links>
            {
              links.map((link, index) => {
                if (link.children && link.children.length > 0) {
                  return (
                    <Collapsible
                      class="group w-full opacity-0"
                      style={`--link-index: ${index}`}
                      data-nav-link
                    >
                      <div class="text-muted-foreground hover:text-foreground -mx-3 flex w-full items-center justify-between rounded-md px-3 transition-colors">
                        {link.href ? (
                          <SheetClose asChild>
                            <a href={link.href} class="flex-1 py-2 text-xl">
                              {link.label}
                            </a>
                          </SheetClose>
                        ) : (
                          <span class="flex-1 py-2 text-xl">{link.label}</span>
                        )}
                        <CollapsibleTrigger asChild>
                          <button type="button" aria-label={`${link.label} submenu`} class="py-2 pl-2">
                            <IconChevronDown class="size-5 transition-transform duration-200 group-data-[state=open]:rotate-180" />
                          </button>
                        </CollapsibleTrigger>
                      </div>
                      <CollapsibleContent class="flex flex-col pl-4">
                        {link.children.map((child) => (
                          <SheetClose asChild>
                            <a
                              href={child.href}
                              class="text-muted-foreground hover:text-foreground w-full rounded-md py-2 text-lg transition-colors"
                            >
                              {child.label}
                            </a>
                          </SheetClose>
                        ))}
                      </CollapsibleContent>
                    </Collapsible>
                  );
                }

                return (
                  <SheetClose asChild>
                    <a
                      href={link.href}
                      class="text-muted-foreground hover:text-foreground -mx-3 rounded-md px-3 py-2 text-xl opacity-0 transition-colors"
                      style={`--link-index: ${index}`}
                      data-nav-link
                    >
                      {link.label}
                    </a>
                  </SheetClose>
                );
              })
            }
          </div>
          <SheetFooter class="mt-auto flex-col gap-2 pb-6">
            {
              secondaryText && (
                <SheetClose asChild>
                  <Button variant="outline" href={secondaryHref} class="w-full">
                    {secondaryText}
                  </Button>
                </SheetClose>
              )
            }
            <SheetClose asChild>
              <Button href={ctaHref} class="w-full">{ctaText}</Button>
            </SheetClose>
          </SheetFooter>
          <IconX class="size-6" slot="icon" />
        </SheetContent>
      </Sheet>
    </div>

    <!-- Logo / Site Name -->
    <div class="mr-auto flex shrink-0 items-center">
      <slot name="logo">
        <a href="/" class="font-heading text-2xl font-semibold">
          {siteName}
        </a>
      </slot>

      <!-- Desktop Navigation Links -->
      <div class="ml-6 hidden items-center gap-3 @2xl:flex">
        {
          links.map((link) => {
            if (link.children && link.children.length > 0) {
              if (link.href) {
                return (
                  <div class="text-muted-foreground hover:text-foreground flex items-center rounded-md transition-colors">
                    <a href={link.href} class="rounded-md py-2 pl-3">
                      {link.label}
                    </a>
                    <Dropdown>
                      <DropdownTrigger asChild>
                        <button
                          type="button"
                          aria-label={`${link.label} submenu`}
                          class="flex cursor-pointer items-center rounded-md py-2 pr-3 pl-1"
                        >
                          <IconChevronDown class="size-4" />
                        </button>
                      </DropdownTrigger>
                      <DropdownContent align="start">
                        {link.children.map((child) => (
                          <DropdownLinkItem href={child.href}>
                            {child.label}
                          </DropdownLinkItem>
                        ))}
                      </DropdownContent>
                    </Dropdown>
                  </div>
                );
              }

              return (
                <Dropdown>
                  <DropdownTrigger asChild>
                    <button
                      type="button"
                      class="text-muted-foreground hover:text-foreground flex cursor-pointer items-center gap-1 rounded-md px-3 py-2 transition-colors"
                    >
                      {link.label}
                      <IconChevronDown class="size-4" />
                    </button>
                  </DropdownTrigger>
                  <DropdownContent align="start">
                    {link.children.map((child) => (
                      <DropdownLinkItem href={child.href}>
                        {child.label}
                      </DropdownLinkItem>
                    ))}
                  </DropdownContent>
                </Dropdown>
              );
            }

            return (
              <a
                href={link.href}
                class="text-muted-foreground hover:text-foreground rounded-md px-3 py-2 transition-colors"
              >
                {link.label}
              </a>
            );
          })
        }
      </div>
    </div>

    <!-- Desktop CTA Buttons -->
    <div class="hidden items-center gap-2 @2xl:flex">
      {
        secondaryText && (
          <Button size="sm" variant="outline" href={secondaryHref}>
            {secondaryText}
          </Button>
        )
      }
      <Button size="sm" href={ctaHref}>{ctaText}</Button>
    </div>
  </div>
</nav>

<style>
  [data-nav-link].animate-in {
    animation: slide-in 0.3s ease-out forwards;
    animation-delay: calc(var(--link-index) * 75ms);
  }

  @keyframes slide-in {
    from {
      opacity: 0;
      transform: translateX(-1rem);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>

<script is:inline src="/scripts/navbar4.js"></script>
