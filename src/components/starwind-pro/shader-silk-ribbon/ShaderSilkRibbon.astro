---
import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";

interface Props extends HTMLAttributes<"div"> {
  /** Silk drift multiplier. */
  silkDrift?: number;
  /** Ribbon field scale. */
  ribbonScale?: number;
  /** Ribbon body width multiplier. */
  ribbonWidth?: number;
  /** Ribbon sheen highlight width multiplier. */
  sheenWidth?: number;
  /** Ribbon sheen strength. */
  sheenStrength?: number;
  /** Sets the overall opacity of the shader background wrapper. */
  opacity?: number;
  /** Caps device pixel ratio for sharper output without runaway GPU cost. */
  maxDpr?: number;
  /** Caps the animation frame rate for performance-sensitive pages. */
  maxFps?: 30 | 45 | 60;
  /** Primary ribbon color as a CSS color or normalized RGB. */
  primaryRibbonColor?: string;
  /** Secondary ribbon color as a CSS color or normalized RGB. */
  secondaryRibbonColor?: string;
  /** Sheen highlight color as a CSS color or normalized RGB. */
  sheenColor?: string;
}

const backgroundStyles = tv({
  base: "pointer-events-none absolute inset-0 overflow-hidden",
});

const {
  silkDrift = 0.84,
  ribbonScale = 2,
  ribbonWidth = 1.2,
  sheenWidth = 1.05,
  sheenStrength = 0.86,
  opacity = 0.92,
  maxDpr = 1.5,
  maxFps = 60,
  primaryRibbonColor = "#fa6b45",
  secondaryRibbonColor = "#30d1b8",
  sheenColor = "#edd1ad",
  class: className,
  style,
  ...rest
} = Astro.props;

const inlineStyle = [`opacity: ${opacity}`, style].filter(Boolean).join("; ");
---

<div
  class={backgroundStyles({ class: className })}
  data-shader-silk-ribbon
  data-shader-state="loading"
  aria-hidden="true"
  {...rest}
  style={inlineStyle}
>
  <div class="shader-silk-ribbon-fallback absolute inset-0"></div>
  <canvas
    class="absolute inset-0 size-full"
    data-shader-silk-ribbon-canvas
    data-shader-max-dpr={maxDpr}
    data-shader-max-fps={maxFps}
    data-shader-primary-ribbon-color={primaryRibbonColor}
    data-shader-ribbon-scale={ribbonScale}
    data-shader-ribbon-width={ribbonWidth}
    data-shader-secondary-ribbon-color={secondaryRibbonColor}
    data-shader-sheen-color={sheenColor}
    data-shader-sheen-strength={sheenStrength}
    data-shader-sheen-width={sheenWidth}
    data-shader-silk-drift={silkDrift}></canvas>
</div>

<script>
  import { initShaderSilkRibbonBackgrounds } from "./shaders";

  initShaderSilkRibbonBackgrounds();
  document.addEventListener("astro:after-swap", initShaderSilkRibbonBackgrounds);
</script>

<style>
  .shader-silk-ribbon-fallback {
    background-color: var(--color-background);
    background:
      radial-gradient(
        circle at 22% 36%,
        color-mix(in oklab, var(--color-primary) 18%, transparent),
        transparent 34%
      ),
      radial-gradient(
        circle at 78% 56%,
        color-mix(in oklab, var(--color-primary-accent) 16%, transparent),
        transparent 38%
      ),
      linear-gradient(
        135deg,
        var(--color-background),
        color-mix(in oklab, var(--color-primary) 9%, var(--color-background)) 52%,
        var(--color-background)
      );
  }

  [data-shader-silk-ribbon] canvas,
  .shader-silk-ribbon-fallback {
    opacity: 0;
    transition: opacity 320ms ease;
  }

  [data-shader-silk-ribbon][data-shader-state="running"] canvas {
    opacity: 1;
  }

  [data-shader-silk-ribbon][data-shader-state="fallback"] canvas {
    display: none;
  }

  [data-shader-silk-ribbon][data-shader-state="fallback"] .shader-silk-ribbon-fallback {
    opacity: 1;
  }
</style>
