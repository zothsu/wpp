---
import IconPear from "../icons/pear.svg";
import Footer3, { type FooterColumn } from "./starwind-pro/footer-03/Footer3.astro";

interface Props {
	/** Which portal this footer renders in. Each portal is deployed to its own
	 * subdomain, so the footer must only link to pages that exist in that
	 * deployment - "none" is used on the shared chooser/legal pages, which are
	 * duplicated across both portal deployments and so can't link into either. */
	portal?: "about" | "enrolled" | "none";
}

const { portal = "none" } = Astro.props;

const aboutColumns: FooterColumn[] = [
	{
		title: "Learn About Us",
		links: [
			{ label: "Our Approach to Learning", href: "/our-approach" },
			{ label: "Enrollment Information", href: "/enrollment-information" },
			{ label: "Who We Are", href: "/who-we-are" },
			{ label: "FAQ", href: "/our-approach#faq" },
		],
	},
	{
		title: "Our Programs",
		links: [
			{ label: "Infant/Toddler", href: "/programs/infant-toddler" },
			{ label: "Preschool", href: "/programs/preschool" },
			{ label: "School Age Summer Camp", href: "/programs/summer-camp" },
			{ label: "Enrollment Information", href: "/enrollment-information" },
		],
	},
];

const enrolledColumns: FooterColumn[] = [
	{
		title: "Currently Enrolled Student(s)",
		links: [
			{ label: "Family Handbooks", href: "/handbooks" },
			{ label: "Tuition", href: "/tuition" },
			{ label: "Forms", href: "/forms" },
			{ label: "Calendar", href: "/enrolled-students" },
			{ label: "Resources", href: "/resources" },
		],
	},
];

const columns: FooterColumn[] =
	portal === "about" ? aboutColumns : portal === "enrolled" ? enrolledColumns : [];
---

<Footer3
	companyName="Wild Pear Preschool & Summer Camp"
	description="Your family will be accepted and valued at Wild Pear Preschool regardless of you or your child's race, religion, gender, ability, orientation, class, country of origin, immigration status, language, or education level. We respect all family structures; whether you are connected by blood, or law, or love alone, you are welcome here."
	logoIcon={IconPear}
	columns={columns}
	socialLinks={[]}
	attributionLinks={[{ label: "Attributions", href: "/attributions" }]}
/>
