---
import IconPear from "../icons/pear.svg";
import Footer3, { type FooterColumn } from "./starwind-pro/footer-03/Footer3.astro";

interface Props {
	/** Which portal this footer renders in. "about" covers wildpear.school
	 * (chooser + about pages, including the shared legal pages, which are also
	 * duplicated onto enrolled.wildpear.school - the about column links are
	 * absolute so they still resolve correctly from there). */
	portal?: "about" | "enrolled";
}

const { portal = "about" } = Astro.props;

const aboutColumns: FooterColumn[] = [
	{
		title: "Learn About Us",
		links: [
			{ label: "Our Approach to Learning", href: "https://wildpear.school/our-approach" },
			{
				label: "Enrollment Information",
				href: "https://wildpear.school/enrollment-information",
			},
			{ label: "Who We Are", href: "https://wildpear.school/who-we-are" },
			{ label: "FAQ", href: "https://wildpear.school/our-approach#faq" },
		],
	},
	{
		title: "Our Programs",
		links: [
			{ label: "Infant/Toddler", href: "https://wildpear.school/programs/infant-toddler" },
			{ label: "Preschool", href: "https://wildpear.school/programs/preschool" },
			{
				label: "School Age Summer Camp",
				href: "https://wildpear.school/programs/summer-camp",
			},
			{
				label: "Enrollment Information",
				href: "https://wildpear.school/enrollment-information",
			},
		],
	},
];

const enrolledColumns: FooterColumn[] = [
	{
		title: "Currently Enrolled Student(s)",
		links: [
			{ label: "Family Handbooks", href: "/handbooks" },
			{ label: "Tuition", href: "/tuition" },
			{ label: "Forms", href: "/forms" },
			{ label: "Calendar", href: "/enrolled-students" },
			{ label: "Resources", href: "/resources" },
		],
	},
];

const columns: FooterColumn[] = portal === "enrolled" ? enrolledColumns : aboutColumns;
---

<Footer3
	companyName="Wild Pear Preschool & Summer Camp"
	description="Your family will be accepted and valued at Wild Pear Preschool regardless of you or your child's race, religion, gender, ability, orientation, class, country of origin, immigration status, language, or education level. We respect all family structures; whether you are connected by blood, or law, or love alone, you are welcome here."
	logoIcon={IconPear}
	columns={columns}
	socialLinks={[]}
	attributionLinks={[{ label: "Attributions", href: "/attributions" }]}
/>
