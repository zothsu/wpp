---
import {
	Accordion as StarwindAccordion,
	AccordionContent,
	AccordionItem as StarwindAccordionItem,
	AccordionTrigger,
} from "@/components/starwind/accordion";

export interface AccordionBlock {
	type: "p" | "list" | "table";
	text?: string;
	items?: string[];
	headers?: string[];
	rows?: string[][];
}

export interface AccordionItem {
	title: string;
	content: AccordionBlock[];
}

interface Props {
	items: AccordionItem[];
	defaultValue?: string;
}

const { items, defaultValue } = Astro.props;
---

<StarwindAccordion defaultValue={defaultValue} class="space-y-2">
	{
		items.map((item, idx) => (
			<StarwindAccordionItem value={`item-${idx + 1}`}>
				<h3>
					<AccordionTrigger class="text-xl font-semibold">
						{item.title}
					</AccordionTrigger>
				</h3>
				<AccordionContent class="text-muted-foreground space-y-4 text-pretty">
					{item.content.map((block) => {
						if (block.type === "list") {
							return (
								<ul class="list-disc space-y-1 pl-5">
									{(block.items ?? []).map((li) => (
										<li>{li}</li>
									))}
								</ul>
							);
						}
						if (block.type === "table") {
							return (
								<div class="overflow-x-auto rounded-lg border">
									<table class="w-full text-sm">
										<thead>
											<tr class="border-b">
												{(block.headers ?? []).map((h) => (
													<th class="text-foreground px-4 py-2 text-left font-semibold">{h}</th>
												))}
											</tr>
										</thead>
										<tbody>
											{(block.rows ?? []).map((row) => (
												<tr class="border-b last:border-b-0">
													{row.map((cell) => (
														<td class="px-4 py-2">{cell}</td>
													))}
												</tr>
											))}
										</tbody>
									</table>
								</div>
							);
						}
						return <p>{block.text}</p>;
					})}
				</AccordionContent>
			</StarwindAccordionItem>
		))
	}
</StarwindAccordion>
