---
import IconSchool from "@tabler/icons/outline/school.svg";
import IconSeedling from "@tabler/icons/outline/seedling.svg";

import Feature12 from "./starwind-pro/feature-12/Feature12.astro";
---

<div>
  <h2 class="text-2xl font-semibold">School Year Tuition</h2>
  <div class="text-muted-foreground mt-4 space-y-4 text-pretty">
    <p>
      During the school year, tuition is paid for 9.5 months and is due on
      the 15th of the month before care is given. Families pay to reserve
      their slot for the upcoming month, and tuition remains the same
      regardless of attendance changes due to illness, vacations, holidays,
      or school closures.
    </p>
    <p>
      We encourage everyone to pay online through Zelle by tagging our email
      address. (It may show up as Wild Primrose Preschool, that's still us!)
      We also accept personal checks and cashier's checks, which can be
      placed in the check box.
    </p>
    <p>
      Tuition rates include meals, snacks, and sunscreen for all children,
      along with diapers, wipes, and diaper cream for children who need
      them.
    </p>
    <p>
      We know childcare is expensive and we gladly welcome families enrolled
      in the ERDC program or who plan to pay for childcare using another
      government subsidy. If your family does not qualify for ERDC but you
      still struggle to afford tuition, we may be able to help you with a
      partial scholarship — please ask us for more information.
      Unfortunately, as we are located in Clackamas County, we are not
      eligible for Preschool For All.
    </p>

    <Feature12
      tagline="2025 - 2026"
      heading="Tuition Rates"
      tabs={[
        { id: "sprouts", label: "Sprouts", icon: IconSeedling },
        { id: "preschool", label: "Preschool", icon: IconSchool },
      ]}
    >
      <div slot="tab-sprouts" class="overflow-x-auto rounded-lg border">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b">
              <th class="text-foreground px-4 py-2 text-left font-semibold"
                >Schedule</th
              >
              <th class="text-foreground px-4 py-2 text-left font-semibold"
                >Monthly Rate</th
              >
            </tr>
          </thead>
          <tbody>
            <tr class="border-b">
              <td class="px-4 py-2">Five days</td>
              <td class="px-4 py-2">$2,225</td>
            </tr>
            <tr class="border-b">
              <td class="px-4 py-2">Four days</td>
              <td class="px-4 py-2">$2,075</td>
            </tr>
            <tr class="border-b">
              <td class="px-4 py-2">Three days</td>
              <td class="px-4 py-2">$1,825</td>
            </tr>
            <tr class="border-b last:border-b-0">
              <td class="px-4 py-2">Two days</td>
              <td class="px-4 py-2">$1,775</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div slot="tab-preschool" class="overflow-x-auto rounded-lg border">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b">
              <th class="text-foreground px-4 py-2 text-left font-semibold"
                >Schedule</th
              >
              <th class="text-foreground px-4 py-2 text-left font-semibold"
                >Monthly Rate</th
              >
            </tr>
          </thead>
          <tbody>
            <tr class="border-b">
              <td class="px-4 py-2">Five days</td>
              <td class="px-4 py-2">$1,725</td>
            </tr>
            <tr class="border-b">
              <td class="px-4 py-2">Four days</td>
              <td class="px-4 py-2">$1,575</td>
            </tr>
            <tr class="border-b">
              <td class="px-4 py-2">Three days</td>
              <td class="px-4 py-2">$1,425</td>
            </tr>
            <tr class="border-b last:border-b-0">
              <td class="px-4 py-2">Two days</td>
              <td class="px-4 py-2">$1,275</td>
            </tr>
          </tbody>
        </table>
      </div>
    </Feature12>
  </div>
</div>
