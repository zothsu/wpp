---
import IconBulb from "@tabler/icons/outline/bulb.svg";
import IconLeaf from "@tabler/icons/outline/leaf.svg";

import { getOgImage } from "../lib/utils/ogImage";

interface PhotoCard {
  size: "large";
  image: string;
  heading: string;
  teaser: string;
  href: string;
}

interface IconCard {
  size: "small";
  icon: astroHTML.JSX.Element;
  heading: string;
  teaser: string;
  href: string;
}

type Card = PhotoCard | IconCard;

const FALLBACK_IMAGE = "/images/temp-blog.png";

const generationMindfulHref = "https://genmindful.com/";
const thousandHoursHref = "https://www.1000hoursoutside.com/";

const [generationMindfulImage, thousandHoursImage] = await Promise.all([
  getOgImage(generationMindfulHref),
  getOgImage(thousandHoursHref),
]);

const cards: Card[] = [
  {
    size: "large",
    image: generationMindfulImage ?? FALLBACK_IMAGE,
    heading: "Generation Mindful",
    teaser: "Tools and visuals for teaching emotional regulation to young children.",
    href: generationMindfulHref,
  },
  {
    size: "small",
    icon: IconLeaf,
    heading: "Explorations Early Learning",
    teaser: "Practical ideas for play-based, nature-inspired early learning activities.",
    href: "https://www.explorationsearlylearning.com/",
  },
  {
    size: "small",
    icon: IconBulb,
    heading: "The Curiosity Approach",
    teaser: "Inspiration for calm, curiosity-driven early learning environments.",
    href: "https://www.thecuriosityapproach.com/",
  },
  {
    size: "large",
    image: thousandHoursImage ?? FALLBACK_IMAGE,
    heading: "1000 Hours Outside",
    teaser: "A challenge and resource hub encouraging families to spend more time outdoors.",
    href: thousandHoursHref,
  },
];
---

<section class="@container mx-auto max-w-6xl px-4 py-24">
  <div class="text-center">
    <h2>Resources</h2>
    <p class="text-muted-foreground mt-4 text-pretty">
      A few of our favorite links for families. See the full list on the{" "}
      <a href="/resources" class="text-primary-accent font-medium hover:underline">
        Resources
      </a>{" "}
      page.
    </p>
  </div>

  <ul class="mt-12 grid gap-6 @xl:grid-cols-3">
    {
      cards.map((card) =>
        card.size === "large" ? (
          <li class="@xl:col-span-2">
            <a
              href={card.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group border-4 border-transparent relative flex aspect-16/10 flex-col justify-end overflow-hidden rounded-2xl transition-all duration-300 hover:scale-[1.02] hover:border-primary-accent"
            >
              <img
                src={card.image}
                alt={card.heading}
                class="absolute inset-0 size-full object-cover"
              />
              <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/20 to-transparent" />
              <div class="relative p-6">
                <h3 class="text-xl font-semibold text-white">{card.heading}</h3>
                <p class="mt-2 text-sm text-pretty text-white/80">{card.teaser}</p>
              </div>
            </a>
          </li>
        ) : (
          <li class="@xl:col-span-1">
            <a
              href={card.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group bg-muted border-border hover:border-primary-accent flex aspect-16/10 flex-col justify-center gap-3 rounded-2xl border p-6 transition-all duration-300 hover:scale-[1.02] @xl:aspect-auto @xl:h-full"
            >
              <div class="bg-background flex size-12 items-center justify-center rounded-lg border">
                <card.icon class="text-primary-accent size-6" />
              </div>
              <h3 class="text-lg font-semibold">{card.heading}</h3>
              <p class="text-muted-foreground text-sm text-pretty">{card.teaser}</p>
            </a>
          </li>
        ),
      )
    }
  </ul>
</section>
