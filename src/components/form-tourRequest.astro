---
import IconChevronDown from "@tabler/icons/outline/chevron-down.svg";
import IconMail from "@tabler/icons/outline/mail.svg";
import IconMapPin from "@tabler/icons/outline/map-pin.svg";
import IconPhone from "@tabler/icons/outline/phone.svg";
import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";

import { Button } from "@/components/starwind/button";
import { Card, CardContent } from "@/components/starwind/card";
import {
  Dropdown,
  DropdownCheckboxItem,
  DropdownContent,
  DropdownTrigger,
} from "@/components/starwind/dropdown";
import { Input } from "@/components/starwind/input";
import { Label } from "@/components/starwind/label";
import {
  Select,
  SelectContent,
  SelectGroup,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/starwind/select";
import { Textarea } from "@/components/starwind/textarea";

/** Service option for the select dropdown */
export interface ServiceOption {
  value: string;
  label: string;
}

interface Props extends HTMLAttributes<"section"> {
  /** Badge/eyebrow text */
  badge?: string;
  /** Section heading */
  heading?: string;
  /** Section description */
  description?: string;
  /** Business address */
  address?: string;
  /** Business phone */
  phone?: string;
  /** Business email */
  email?: string;
  /** Map embed URL (Google Maps, OpenStreetMap, etc.) */
  mapEmbedUrl?: string;
  /** Service options for dropdown (or checkboxes, if serviceMultiple is true) */
  services?: ServiceOption[];
  /** Label for the service field */
  serviceLabel?: string;
  /** Placeholder for the service select field (ignored when serviceMultiple is true) */
  servicePlaceholder?: string;
  /** Render the service field as a checkbox group allowing multiple selections */
  serviceMultiple?: boolean;
  /** Placeholder for the message textarea */
  messagePlaceholder?: string;
}

const sectionStyles = tv({
  base: "@container mx-auto w-full max-w-7xl px-4 py-24",
});

const {
  heading = "Request a Tour",
  description = "Before enrolling in Wild Pear, come visit us and see if we resonate with what you have in mind for your child's care.",
  address = "9411 SE Wichita Ave, Portland, OR",
  phone = "",
  email = "",
  mapEmbedUrl = `https://maps.google.com/maps?q=${encodeURIComponent(address)}&output=embed`,
  services = [
    { value: "infant-toddler", label: "Infant/Toddler" },
    { value: "preschool", label: "Preschool" },
    { value: "summer-camp", label: "School Age Summer Camp" },
    { value: "no-program", label: "No Program / Not Sure Yet" },
  ],
  serviceLabel = "Program(s) of Interest",
  servicePlaceholder = "Select a service",
  serviceMultiple = true,
  messagePlaceholder = "Let us know the best time for you to come by for a tour.",
  class: className,
  ...rest
} = Astro.props;
---

<section class={sectionStyles({ class: className })} {...rest}>
  <!-- Header -->
  <div class="mb-12 text-center">
    <h2>{heading}</h2>
    <p class="text-muted-foreground mx-auto mt-4 max-w-2xl">
      {description}
    </p>
  </div>

  <div class="grid gap-8 @3xl:grid-cols-5">
    <!-- Map Section -->
    <div class="@3xl:col-span-3">
      <div
        class="bg-muted relative aspect-[4/3] overflow-hidden rounded-2xl border @3xl:aspect-auto @3xl:h-full"
      >
        {
          mapEmbedUrl ? (
            <iframe
              src={mapEmbedUrl}
              class="absolute inset-0 h-full w-full"
              style="border:0;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Business location map"
            />
          ) : (
            <div class="absolute inset-0 flex flex-col items-center justify-center p-8 text-center">
              <div class="bg-primary/10 mb-4 rounded-full p-4">
                <IconMapPin class="text-primary-accent size-8" />
              </div>
              <p class="text-muted-foreground text-sm">Map placeholder</p>
              <p class="text-muted-foreground mt-1 text-xs">
                Add your Google Maps or OpenStreetMap embed URL
              </p>
            </div>
          )
        }

        <!-- Floating Contact Cards -->
        {
          (phone || email) && (
            <div class="absolute right-4 bottom-4 left-4 flex flex-wrap gap-3 @xl:right-6 @xl:bottom-6 @xl:left-6">
              {phone && (
                <a
                  href={`tel:${phone.replace(/[^0-9+]/g, "")}`}
                  class="bg-background/95 hover:bg-background flex items-center gap-2 rounded-lg px-4 py-2.5 shadow-lg backdrop-blur-sm transition-colors"
                >
                  <IconPhone class="text-primary-accent size-4" />
                  <span class="text-sm font-medium">{phone}</span>
                </a>
              )}
              {email && (
                <a
                  href={`mailto:${email}`}
                  class="bg-background/95 hover:bg-background flex items-center gap-2 rounded-lg px-4 py-2.5 shadow-lg backdrop-blur-sm transition-colors"
                >
                  <IconMail class="text-primary-accent size-4" />
                  <span class="text-sm font-medium">{email}</span>
                </a>
              )}
            </div>
          )
        }
      </div>
    </div>

    <!-- Contact Form -->
    <div class="@3xl:col-span-2">
      <Card class="h-full">
        <CardContent class="flex h-full flex-col">

          <form class="flex flex-1 flex-col space-y-4" id="contact-form-03" name="contact-form">
            <div class="flex flex-col gap-1">
              <Label for="contact-name-03">Name</Label>
              <Input
                id="contact-name-03"
                name="name"
                type="text"
                placeholder="Your name"
                required
              />
            </div>

            <div class="flex flex-col gap-1">
              <Label for="contact-email-03">Email</Label>
              <Input
                id="contact-email-03"
                name="email"
                type="email"
                placeholder="you@example.com"
                required
              />
            </div>

            <div class="flex flex-col gap-1">
              <Label for="contact-phone-03">Phone</Label>
              <Input id="contact-phone-03" name="phone" type="tel" placeholder="(555) 123-4567" />
            </div>

            {
              services.length > 0 &&
                (serviceMultiple ? (
                  <div class="flex flex-col gap-1">
                    <Label id="contact-service-03-label">{serviceLabel}</Label>
                    <Dropdown data-service-dropdown>
                      <DropdownTrigger
                        id="contact-service-03"
                        aria-labelledby="contact-service-03-label"
                        class="border-input dark:bg-input/30 text-foreground ring-offset-background h-11 w-full justify-between rounded-md border bg-transparent px-3 text-base shadow-xs [&>span]:line-clamp-1"
                        data-service-trigger
                      >
                        <span class="text-muted-foreground truncate" data-service-trigger-label>
                          {servicePlaceholder}
                        </span>
                        <IconChevronDown class="size-4 shrink-0 opacity-50" />
                      </DropdownTrigger>
                      <DropdownContent align="start" class="min-w-56">
                        {services.map((service) => (
                          <DropdownCheckboxItem data-service-value={service.value}>
                            {service.label}
                          </DropdownCheckboxItem>
                        ))}
                      </DropdownContent>
                    </Dropdown>
                    {services.map((service) => (
                      <input type="checkbox" name="service" value={service.value} class="hidden" data-service-input />
                    ))}
                  </div>
                ) : (
                  <div class="flex flex-col gap-1">
                    <Label for="contact-service-03">{serviceLabel}</Label>
                    <Select id="contact-service-03" name="service">
                      <SelectTrigger class="w-full">
                        <SelectValue placeholder={servicePlaceholder} />
                      </SelectTrigger>
                      <SelectContent>
                        <SelectGroup>
                          {services.map((service) => (
                            <SelectItem value={service.value}>{service.label}</SelectItem>
                          ))}
                        </SelectGroup>
                      </SelectContent>
                    </Select>
                  </div>
                ))
            }

            <div class="flex flex-1 flex-col gap-1">
              <Label for="contact-message-03">Message</Label>
              <Textarea
                id="contact-message-03"
                name="message"
                placeholder={messagePlaceholder}
                class="min-h-[100px] resize-none"
                required
              />
            </div>

            <Button variant="accent" type="submit" class="w-full"> Request a tour </Button>
          </form>
        </CardContent>
      </Card>
    </div>
  </div>

  <!-- Address Bar -->
  {
    address && (
      <div class="bg-muted/50 mt-8 flex flex-wrap items-center justify-center gap-2 rounded-xl border px-6 py-4 text-center">
        <IconMapPin class="text-primary-accent size-5" />
        <span class="text-foreground font-medium">{address}</span>
      </div>
    )
  }
</section>

<script>
  function handleFormSubmit() {
    const form = document.querySelector("#contact-form-03") as HTMLFormElement;

    if (form) {
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const formData = new FormData(form);
        const formValues = Object.fromEntries(formData.entries());

        // demo form data logging
        console.log("Contact form:", formValues);

        // You can add additional logic here like:
        // - Form validation
        // - API submission
        // - Success/error handling
      });
    }
  }

  handleFormSubmit();

  function initServiceDropdown(dropdown: HTMLElement) {
    const wrapper = dropdown.parentElement;
    const labelEl = wrapper?.querySelector<HTMLElement>("[data-service-trigger-label]");
    if (!wrapper || !labelEl) return;

    const placeholder = labelEl.textContent?.trim() ?? "";
    const hiddenInputs = Array.from(
      wrapper.querySelectorAll<HTMLInputElement>("[data-service-input]"),
    );
    const items = Array.from(dropdown.querySelectorAll<HTMLElement>("[data-service-value]"));

    const updateLabel = () => {
      const selected = hiddenInputs.filter((input) => input.checked);
      if (selected.length === 0) {
        labelEl.textContent = placeholder;
        labelEl.classList.add("text-muted-foreground");
      } else {
        labelEl.textContent = selected
          .map((input) => {
            const item = items.find((el) => el.getAttribute("data-service-value") === input.value);
            return item?.textContent?.trim() ?? input.value;
          })
          .join(", ");
        labelEl.classList.remove("text-muted-foreground");
      }
    };

    dropdown.addEventListener("starwind-dropdown-checkbox:change", (e) => {
      const event = e as CustomEvent<{ checked: boolean }>;
      const value = (event.target as HTMLElement).getAttribute("data-service-value");
      const input = hiddenInputs.find((el) => el.value === value);
      if (input) input.checked = event.detail.checked;
      updateLabel();
    });

    updateLabel();
  }

  function handleServiceDropdowns() {
    document
      .querySelectorAll<HTMLElement>("[data-service-dropdown]")
      .forEach(initServiceDropdown);
  }

  handleServiceDropdowns();

  document.addEventListener("astro:after-swap", () => {
    handleFormSubmit();
    handleServiceDropdowns();
  });
</script>
