---
import IconSchool from "@tabler/icons/outline/school.svg";
import IconUsers from "@tabler/icons/outline/users.svg";
import {
	Select,
	SelectContent,
	SelectItem,
	SelectTrigger,
	SelectValue,
} from "@/components/starwind/select";

interface Props {
	/** Which section is currently active */
	current: "about" | "enrolled";
	/** Unique id for this instance (needed when rendering more than one switcher on a page, e.g. desktop + mobile) */
	id?: string;
	class?: string;
}

const { current, id = "section-switcher", class: className } = Astro.props;
const currentHref = current === "enrolled" ? "/enrolled-students" : "/learn-about-us";
---

<Select
	id={id}
	name="section"
	class:list={["section-switcher", className]}
	data-section-switcher
	data-current={currentHref}
>
	<SelectTrigger size="sm" class="w-full min-w-[170px]">
		<SelectValue placeholder="" />
	</SelectTrigger>
	<SelectContent size="sm">
		<SelectItem value="/learn-about-us">
			<div class="flex items-center gap-2">
				<IconSchool class="size-4" />
				<span>Learn About Us</span>
			</div>
		</SelectItem>
		<SelectItem value="/enrolled-students">
			<div class="flex items-center gap-2">
				<IconUsers class="size-4" />
				<span>Enrolled Students</span>
			</div>
		</SelectItem>
	</SelectContent>
</Select>

<script>
	import type { SelectChangeEvent } from "@/components/starwind/select/SelectTypes";

	function initSectionSwitcher() {
		const switchers = document.querySelectorAll<HTMLElement>("[data-section-switcher]");

		switchers.forEach((switcher) => {
			if (switcher.dataset.sectionSwitcherReady) return;
			switcher.dataset.sectionSwitcherReady = "true";

			let isInitializing = true;
			const currentHref = switcher.getAttribute("data-current") || "/learn-about-us";
			const selectId = switcher.id;

			switcher.addEventListener("starwind-select:change", (event: Event) => {
				if (isInitializing) {
					isInitializing = false;
					return;
				}
				const { value } = (event as SelectChangeEvent).detail;
				if (value && value !== window.location.pathname) {
					window.location.href = value;
				}
			});

			// Reflect the current page in the trigger without treating it as a user change
			document.dispatchEvent(
				new CustomEvent("starwind-select:select", {
					detail: { selectId, value: currentHref },
				}),
			);
		});
	}

	initSectionSwitcher();
	document.addEventListener("astro:after-swap", initSectionSwitcher);
</script>
