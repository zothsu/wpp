---
import { Image } from "@/components/starwind/image";
import {
  Carousel,
  CarouselContent,
  CarouselItem,
  CarouselNext,
  CarouselPrevious,
} from "@/components/starwind/carousel";

interface CarouselImage {
  src: string;
  alt: string;
  width: number;
  height: number;
}

const images: CarouselImage[] = [
  {
    src: "/images/img_20230728_125229.webp",
    alt: "Two campers laughing outside with googly-eye stickers stuck to their faces",
    width: 686,
    height: 515,
  },
  {
    src: "/images/communicate.webp",
    alt: "Two campers leaning in together over a table, discussing flowers and craft materials",
    width: 450,
    height: 600,
  },
  {
    src: "/images/care.webp",
    alt: "A toddler in a high chair feeding themselves",
    width: 318,
    height: 424,
  },
  {
    src: "/images/img_9502.webp",
    alt: "A group of campers smiling together inside a playhouse structure",
    width: 778,
    height: 1037,
  },
  {
    src: "/images/img_1569.webp",
    alt: "Campers deeply focused together on a collaborative sidewalk chalk drawing",
    width: 3024,
    height: 4032,
  },
  {
    src: "/images/summer.webp",
    alt: "Campers laughing during outdoor water play",
    width: 834,
    height: 1112,
  },
  {
    src: "/images/img_2982.webp",
    alt: "A camper feeding fresh greens to Wild Pear's laying hens through their coop fence",
    width: 304,
    height: 405,
  },
  {
    src: "/images/intro.webp",
    alt: "A Wild Pear student outdoors",
    width: 166,
    height: 221,
  },
  {
    src: "/images/todler.jpg",
    alt: "An infant/toddler student exploring at Wild Pear",
    width: 4480,
    height: 6720,
  },
  { src: "/images/wk1.webp", alt: "Wild Pear summer campers during a weekly themed activity", width: 450, height: 599 },
  { src: "/images/wk2.webp", alt: "Wild Pear summer campers during a weekly themed activity", width: 450, height: 600 },
  { src: "/images/wk3.webp", alt: "Wild Pear summer campers during a weekly themed activity", width: 450, height: 706 },
  { src: "/images/wk4.webp", alt: "Wild Pear summer campers during a weekly themed activity", width: 450, height: 600 },
  { src: "/images/wk5.webp", alt: "Wild Pear summer campers during a weekly themed activity", width: 450, height: 600 },
  { src: "/images/wk6.webp", alt: "Wild Pear summer campers during a weekly themed activity", width: 450, height: 600 },
  { src: "/images/wk7.webp", alt: "Wild Pear summer campers during a weekly themed activity", width: 600, height: 600 },
  { src: "/images/wk8.webp", alt: "Wild Pear summer campers during a weekly themed activity", width: 600, height: 450 },
  { src: "/images/wk9.webp", alt: "Wild Pear summer campers during a weekly themed activity", width: 450, height: 600 },
];
---

<div class="@container mx-auto w-full max-w-6xl px-4 py-12">
  <Carousel opts={{ align: "start", loop: true }} class="mx-auto w-full">
    <CarouselContent>
      {
        images.map((image) => (
          <CarouselItem class="@lg:basis-1/3">
            <Image
              src={image.src}
              alt={image.alt}
              width={image.width}
              height={image.height}
              loading="lazy"
              class="aspect-square w-full rounded-2xl object-cover"
            />
          </CarouselItem>
        ))
      }
    </CarouselContent>
    <CarouselPrevious class="group-data-[axis=x]/carousel:left-2" />
    <CarouselNext class="group-data-[axis=x]/carousel:right-2" />
  </Carousel>
</div>
