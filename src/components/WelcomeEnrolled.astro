---
import { Image } from "@/components/starwind/image";

interface Props {
  heading?: string;
  body?: string;
  signoff?: string;
  signature?: string;
}

const {
  heading = "Welcome, Wild Pear Families!",
  body = "This is your home base for everything happening at Wild Pear this year — handbooks, forms, tuition, and what's coming up on the calendar. If you ever have questions, we're just a message away.",
  signoff = "Thank you!",
  signature = "Jeanie & Susan",
} = Astro.props;
---

<section class="@container bg-green-900">
  <div class="mx-auto max-w-5xl px-4 py-24">
    <div class="flex flex-col items-center gap-10 text-center @lg:flex-row @lg:items-start @lg:text-left">
      <Image
        src="/images/js.webp"
        alt="Jeanie and Susan"
        width={714}
        height={445}
        class="w-full max-w-xs rounded-2xl @lg:shrink-0"
      />
      <div>
        <h2>{heading}</h2>
        <div class="text-muted-foreground mt-8 space-y-4 text-pretty">
          <p>{body}</p>
          <p class="text-right">{signoff}</p>
          <p class="font-signature text-right text-3xl">{signature}</p>
        </div>
      </div>
    </div>
  </div>
</section>
